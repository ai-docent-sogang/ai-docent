# Gemini API 키 (https://aistudio.google.com 에서 발급). .env 파일은 커밋하지 않는다.
GEMINI_API_KEY=
# 사용할 모델 ID. `uv run python -m server.gemini_client --list-models`로 계정에서 쓸 수 있는 ID를 확인해 적는다.
GEMINI_MODEL=
# 1로 두면 /api/ask가 Gemini를 부르지 않고 임시 답변을 돌려준다(FE1 연결 확인용). 실제 답변을 쓰려면 지운다.
ASK_MOCK=
# GEMINI_MODEL이 과부하·사용 불가일 때 차례로 쓸 예비 모델(쉼표로 구분). 비우면 server/ask.py의 기본값을 쓴다.
ASK_FALLBACK_MODELS=
