# Gemini API 키 (https://aistudio.google.com 에서 발급). .env 파일은 커밋하지 않는다.
GEMINI_API_KEY=
# 사용할 모델 ID. `uv run python -m server.gemini_client --list-models`로 계정에서 쓸 수 있는 ID를 확인해 적는다.
GEMINI_MODEL=
# Live 음성 대화(WS /ws/live) 설정. 아래 일곱 줄은 모두 주석 처리해 두었다. 바꿀 줄만 맨 앞 #을
# 지우고 값을 적는다. 값 없이 이름만 남기지 않는다(`LIVE_MODEL=`처럼 비워 두면 기본값으로 간다).
# 이상한 값을 적어도 서버는 켜진다. 경고 한 줄을 찍고 기본값으로 가며, 켤 때 지금 적용된 값을
# `[live] model=... voice=...` 한 줄로 보여 준다.
# Live 음성 모델. 위 GEMINI_MODEL(/api/turn용)과 다른 모델이다.
LIVE_MODEL=gemini-3.8-live
# 도슨트 목소리(11/13 팀 규칙).
LIVE_VOICE=Kore
# 사진을 Live에 넣는 방식. every: 받는 대로 넘김. on_speech: 관람객 말이 시작될 때 최신 1장만.
# LIVE_FRAME_POLICY=every
# 말 시작 감지 민감도(LOW/HIGH). LOW가 "음", "네" 같은 짧은 추임새를 덜 잡는다.
# LIVE_START_SENSITIVITY=LOW
# 이만큼(밀리초) 조용하면 말이 끝났다고 본다(공식 문서 권장 500~800).
# LIVE_SILENCE_MS=700
# 말로 인정하기 전에 필요한 말소리 길이(밀리초).
# LIVE_PREFIX_MS=300
# 폰에서 이 시간(초) 동안 아무것도 안 오면 연결을 닫는다. 폰이 다시 붙으면 대화는 이어진다.
# LIVE_PHONE_IDLE_S=30
# 작품 사실을 주는 시점. per_question(질문마다 조회, 기본) 또는 per_artwork(작품 보고에 함께, 질문당 약 1초 빠름)
# LIVE_FACTS=per_question

# 전시에서 내려간 작품을 켤 때부터 인식 후보에서 뺀다(쉼표로 구분, 작품 ID).
# 운영 페이지(/admin)에서 끈 것은 메모리에만 남으므로 서버를 다시 켜면 이 줄만 남는다.
# LIVE_OFF_ARTWORKS=KHD_SEODANG,LA_DOGS
LIVE_VISIT_LOG = team
LIVE_VISIT_SOURCE_KIND = team_rehearsal